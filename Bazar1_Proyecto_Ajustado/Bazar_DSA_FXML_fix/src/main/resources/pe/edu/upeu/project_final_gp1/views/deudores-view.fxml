<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      spacing="12.0"
      styleClass="page"
      stylesheets="@style.css"
      fx:controller="pe.edu.upeu.project_final_gp1.controller.DeudorController">

    <padding>
        <Insets top="18.0" right="20.0" bottom="18.0" left="20.0"/>
    </padding>

    <children>
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <children>
                <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Clientes y cuentas pendientes" styleClass="page-title"/>
                        <Label text="Registra clientes, administra sus deudas y consulta sus movimientos." styleClass="page-subtitle"/>
                    </children>
                </VBox>
                <Label text="SEGUIMIENTO DE CRÉDITO" styleClass="hero-chip"/>
            </children>
        </HBox>

        <VBox spacing="9.0" styleClass="section-card">
            <children>
                <Label text="Ficha del cliente" styleClass="section-heading"/>
                <GridPane hgap="10.0" vgap="8.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="75.0"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="110.0"/>
                        <ColumnConstraints minWidth="65.0"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="110.0"/>
                    </columnConstraints>
                    <children>
                        <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <TextField fx:id="txtNombre" promptText="Nombre completo" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label text="DNI:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                        <TextField fx:id="txtDni" promptText="DNI" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                        <Label text="Teléfono:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <TextField fx:id="txtTelefono" promptText="Teléfono de contacto" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Label text="Deuda (S/):" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                        <TextField fx:id="txtDeuda" promptText="0.00" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                        <Label text="Detalle:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <TextField fx:id="txtDetalle" promptText="Concepto o detalle del movimiento"
                                   GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="2"/>
                    </children>
                </GridPane>

                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <children>
                        <Button text="Guardar ficha" onAction="#handleGuardar" styleClass="button-login"/>
                        <Button text="Limpiar" onAction="#handleLimpiar" styleClass="button-secondary"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Monto (S/):"/>
                        <TextField fx:id="txtMontoOperacion" promptText="0.00" prefWidth="100.0"/>
                        <Button text="Aumentar deuda" onAction="#handleAumentarDeuda" styleClass="button-action-edit"/>
                        <Button text="Registrar pago" onAction="#handleRegistrarPago" styleClass="button-login"/>
                    </children>
                </HBox>
            </children>
        </VBox>

        <VBox spacing="8.0" styleClass="section-card" VBox.vgrow="ALWAYS">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label text="Registro de clientes con deuda" styleClass="section-heading"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="txtBuscar" promptText="Buscar por nombre o DNI..."
                                   onAction="#handleBuscar" prefWidth="240.0"/>
                    </children>
                </HBox>
                <TableView fx:id="tableDeudores" prefHeight="190.0" minHeight="140.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNombre" text="Cliente" prefWidth="190.0"/>
                        <TableColumn fx:id="colDni" text="DNI" prefWidth="95.0"/>
                        <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="120.0"/>
                        <TableColumn fx:id="colDeuda" text="Deuda (S/)" prefWidth="125.0"/>
                        <TableColumn fx:id="colEstado" text="Estado" prefWidth="135.0"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>

        <VBox fx:id="boxDetalle" spacing="8.0" styleClass="section-card"
              visible="false" managed="false">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label fx:id="lblTituloDetalle" text="Movimientos del cliente" styleClass="section-heading"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Saldo actual:" styleClass="muted-label"/>
                        <Label fx:id="lblTotalDeuda" text="S/ 0.00" styleClass="total-value"/>
                        <Label fx:id="lblEstadoDetalle" text="Deuda Pendiente"/>
                    </children>
                </HBox>
                <HBox spacing="10.0" alignment="TOP_CENTER">
                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <children>
                            <Label text="Ingresos / incrementos de deuda" styleClass="section-heading"/>
                            <TableView fx:id="tableIngresos" prefHeight="145.0" minHeight="110.0" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colIngFecha" text="Fecha" prefWidth="100.0"/>
                                    <TableColumn fx:id="colIngDetalle" text="Detalle" prefWidth="180.0"/>
                                    <TableColumn fx:id="colIngMonto" text="Monto (S/)" prefWidth="110.0"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                            </TableView>
                        </children>
                    </VBox>
                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <children>
                            <Label text="Pagos realizados" styleClass="section-heading"/>
                            <TableView fx:id="tablePagos" prefHeight="145.0" minHeight="110.0" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colPagoFecha" text="Fecha" prefWidth="110.0"/>
                                    <TableColumn fx:id="colPagoMonto" text="Monto pagado (S/)" prefWidth="150.0"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                            </TableView>
                        </children>
                    </VBox>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>
