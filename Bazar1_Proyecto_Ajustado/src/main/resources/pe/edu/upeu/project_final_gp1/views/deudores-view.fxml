<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" stylesheets="@style.css" fx:controller="pe.edu.upeu.project_final_gp1.controller.DeudorController">
  <content>
<VBox spacing="12.0" styleClass="page">
  <padding>
    <Insets top="20.0" right="22.0" bottom="20.0" left="22.0"/>
  </padding>
  <children>
    <HBox alignment="CENTER_LEFT" spacing="12.0">
      <children>
        <VBox spacing="3.0" HBox.hgrow="ALWAYS">
          <children>
            <Label text="Clientes y cuentas pendientes" styleClass="page-title"/>
            <Label text="Consulta los saldos, registra abonos y mantiene un seguimiento claro del crédito." styleClass="page-subtitle"/>
          </children>
        </VBox>
        <Label text="SEGUIMIENTO DE CRÉDITO" styleClass="hero-chip"/>
      </children>
    </HBox>
    <VBox spacing="10.0" styleClass="section-card">
      <children>
        <Label text="Ficha y saldo del cliente" styleClass="section-heading"/>
        <GridPane hgap="12.0" vgap="8.0">
          <columnConstraints>
            <ColumnConstraints minWidth="75.0"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="120.0"/>
            <ColumnConstraints minWidth="55.0"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="105.0"/>
          </columnConstraints>
          <children>
            <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="txtNombre" promptText="Nombre completo" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Label text="DNI:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <TextField fx:id="txtDni" promptText="DNI / identificador" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
            <Label text="Teléfono:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="txtTelefono" promptText="Teléfono" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <Label text="Deuda total (S/):" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <TextField fx:id="txtDeuda" promptText="0.00" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
            <Label text="Productos:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="txtDetalle" promptText="Detalle de los productos que originan la deuda (deuda inicial o aumento)" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="2"/>
          </children>
        </GridPane>
        <HBox alignment="CENTER_LEFT" spacing="8.0">
          <children>
            <Button text="Guardar ficha" onAction="#handleGuardar" styleClass="button-login"/>
            <Button text="Limpiar" onAction="#handleLimpiar" styleClass="button-secondary"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Monto (S/):"/>
            <TextField fx:id="txtMontoOperacion" promptText="0.00" prefWidth="100.0"/>
            <Button text="Aumentar deuda" onAction="#handleAumentarDeuda" styleClass="button-action-edit"/>
            <Button text="Registrar pago" onAction="#handleRegistrarPago" styleClass="button-login"/>
          </children>
        </HBox>
      </children>
    </VBox>
    <VBox spacing="8.0" styleClass="section-card" VBox.vgrow="ALWAYS">
      <children>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
          <children>
            <Label text="Registro de clientes con deuda" styleClass="section-heading"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="txtBuscar" promptText="Buscar por nombre o DNI..." HBox.hgrow="ALWAYS" onAction="#handleBuscar" prefWidth="240.0"/>
          </children>
        </HBox>
        <TableView fx:id="tableDeudores" minHeight="200.0" VBox.vgrow="ALWAYS">
          <columns>
            <TableColumn fx:id="colNombre" text="Cliente" prefWidth="230.0"/>
            <TableColumn fx:id="colDni" text="DNI" prefWidth="110.0"/>
            <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="130.0"/>
            <TableColumn fx:id="colDeuda" text="Deuda pendiente (S/)" prefWidth="160.0"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="140.0"/>
          </columns>
          <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
          </columnResizePolicy>
        </TableView>
        <Label text="Haz clic en un cliente para ver sus movimientos." styleClass="muted-label"/>
      </children>
    </VBox>
    <VBox fx:id="boxDetalle" spacing="10.0" styleClass="section-card" visible="false" managed="false">
      <children>
        <Label fx:id="lblTituloDetalle" text="Movimientos del cliente" styleClass="section-heading"/>
        <HBox spacing="14.0">
          <children>
            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
              <children>
                <Label text="Ingreso de deuda" styleClass="section-heading"/>
                <TableView fx:id="tableIngresos" prefHeight="190.0" minHeight="190.0">
                  <columns>
                    <TableColumn fx:id="colIngFecha" text="Fecha" prefWidth="95.0"/>
                    <TableColumn fx:id="colIngDetalle" text="Detalle de productos" prefWidth="260.0"/>
                    <TableColumn fx:id="colIngMonto" text="Monto (S/)" prefWidth="100.0"/>
                  </columns>
                  <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                  </columnResizePolicy>
                  <placeholder><Label text="Sin deudas registradas"/></placeholder>
                </TableView>
              </children>
            </VBox>
            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
              <children>
                <Label text="Monto pagado" styleClass="section-heading"/>
                <TableView fx:id="tablePagos" prefHeight="190.0" minHeight="190.0">
                  <columns>
                    <TableColumn fx:id="colPagoFecha" text="Fecha" prefWidth="130.0"/>
                    <TableColumn fx:id="colPagoMonto" text="Monto abonado (S/)" prefWidth="160.0"/>
                  </columns>
                  <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                  </columnResizePolicy>
                  <placeholder><Label text="Aún no hay pagos"/></placeholder>
                </TableView>
              </children>
            </VBox>
          </children>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="24.0" styleClass="checkout-bar">
          <children>
            <Label text="TOTAL DE LA DEUDA" styleClass="total-label"/>
            <Label fx:id="lblTotalDeuda" text="S/ 0.00" styleClass="total-value"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="ESTADO" styleClass="total-label"/>
            <Label fx:id="lblEstadoDetalle" text="Deuda Pendiente" styleClass="section-heading"/>
          </children>
        </HBox>
      </children>
    </VBox>
  </children>
</VBox>
  </content>
</ScrollPane>
