<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      spacing="20.0"
      styleClass="page"
      stylesheets="@style.css">
    <padding>
        <Insets top="25.0" right="27.0" bottom="22.0" left="27.0"/>
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT"
              styleClass="dashboard-hero"
              spacing="25.0"
              minHeight="205.0"
              prefHeight="205.0"
              style="-fx-padding: 28;">
            <children>
                <VBox spacing="13.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="TU NEGOCIO, MÁS ORGANIZADO"
                               styleClass="hero-chip"
                               maxWidth="280.0"
                               style="-fx-font-size: 14px;"/>
                        <Label text="Todo tu bazar, bajo control."
                               styleClass="hero-title"
                               wrapText="true"
                               style="-fx-font-size: 32px;"/>
                        <Label text="Controla productos, registra ventas, recupera los datos de tus clientes y mantén las cuentas claras."
                               styleClass="hero-text"
                               wrapText="true"
                               maxWidth="760.0"
                               style="-fx-font-size: 17px;"/>
                    </children>
                </VBox>
                <ImageView fitWidth="215.0"
                           fitHeight="170.0"
                           preserveRatio="true"
                           smooth="true">
                    <image>
                        <Image url="@Img/home-bazar.png"/>
                    </image>
                </ImageView>
            </children>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <children>
                <VBox spacing="5.0">
                    <children>
                        <Label text="Operaciones de la tienda"
                               styleClass="page-title"
                               style="-fx-font-size: 25px;"/>
                        <Label text="Elige una sección para comenzar a trabajar."
                               styleClass="page-subtitle"
                               style="-fx-font-size: 15px;"/>
                    </children>
                </VBox>
            </children>
        </HBox>
        <HBox spacing="25.0"
              alignment="CENTER"
              VBox.vgrow="ALWAYS">
            <children>
                <VBox alignment="CENTER"
                      minWidth="330.0"
                      prefWidth="390.0"
                      maxWidth="420.0"
                      VBox.vgrow="ALWAYS">
                    <children>
                        <ImageView fitWidth="390.0"
                                   fitHeight="500.0"
                                   preserveRatio="true"
                                   smooth="true">
                            <image>
                                <Image url="@Img/ropa-bazar.png"/>
                            </image>
                        </ImageView>
                    </children>
                </VBox>
                <VBox spacing="0.0"
                      alignment="CENTER_LEFT"
                      HBox.hgrow="ALWAYS"
                      VBox.vgrow="ALWAYS"
                      minWidth="400.0">
                    <children>
                        <VBox spacing="8.0"
                              alignment="CENTER_LEFT"
                              VBox.vgrow="ALWAYS"
                              maxWidth="Infinity">
                            <children>
                                <Label text="01  /  EXISTENCIAS"
                                       styleClass="module-number"
                                       style="-fx-font-size: 15px;"/>
                                <Label text="Inventario y productos"
                                       styleClass="module-title"
                                       style="-fx-font-size: 23px;"/>
                                <Label text="Registra artículos, actualiza precios y verifica el stock disponible para evitar vender productos agotados."
                                       styleClass="module-desc"
                                       wrapText="true"
                                       style="-fx-font-size: 16px;"/>
                            </children>
                        </VBox>
                        <VBox spacing="8.0"
                              alignment="CENTER_LEFT"
                              VBox.vgrow="ALWAYS"
                              maxWidth="Infinity">
                            <children>
                                <Label text="02  /  PUNTO DE VENTA"
                                       styleClass="module-number"
                                       style="-fx-font-size: 15px;"/>
                                <Label text="Ventas y boletas"
                                       styleClass="module-title"
                                       style="-fx-font-size: 23px;"/>
                                <Label text="Agrega varios productos, calcula el total, controla el pago y genera una boleta interna para cada operación."
                                       styleClass="module-desc"
                                       wrapText="true"
                                       style="-fx-font-size: 16px;"/>
                            </children>
                        </VBox>
                        <VBox spacing="8.0"
                              alignment="CENTER_LEFT"
                              VBox.vgrow="ALWAYS"
                              maxWidth="Infinity">
                            <children>
                                <Label text="03  /  CLIENTES"
                                       styleClass="module-number"
                                       style="-fx-font-size: 15px;"/>
                                <Label text="Clientes y deudas"
                                       styleClass="module-title"
                                       style="-fx-font-size: 23px;"/>
                                <Label text="Conserva las fichas de clientes y encuentra sus datos escribiendo el nombre, sus iniciales o el DNI."
                                       styleClass="module-desc"
                                       wrapText="true"
                                       style="-fx-font-size: 16px;"/>
                            </children>
                        </VBox>
                        <VBox spacing="8.0"
                              alignment="CENTER_LEFT"
                              VBox.vgrow="ALWAYS"
                              maxWidth="Infinity">
                            <children>
                                <Label text="04  /  FINANZAS"
                                       styleClass="module-number"
                                       style="-fx-font-size: 15px;"/>
                                <Label text="Caja y egresos"
                                       styleClass="module-title"
                                       style="-fx-font-size: 23px;"/>
                                <Label text="Consulta ingresos reales, registra los gastos del negocio y revisa el saldo diario y las deudas pendientes."
                                       styleClass="module-desc"
                                       wrapText="true"
                                       style="-fx-font-size: 16px;"/>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="9.0">
            <children>
                <Label text="●" textFill="#EFA30E"/>
                <Label text="Los registros se guardan en la base de datos local; no tendrás que volver a escribir una ficha ya guardada."
                       styleClass="page-subtitle"
                       wrapText="true"/>
            </children>
        </HBox>
    </children>
</VBox>